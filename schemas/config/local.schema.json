{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "participantDisplayIndex",
    "operatorDisplayIndex",
    "dataRoot",
    "eltsEndpoint"
  ],
  "properties": {
    "weaponTriggerSerial": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "schemaVersion": {
      "const": 1
    },
    "participantDisplayIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "operatorDisplayIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "dataRoot": {
      "type": "string",
      "minLength": 1
    },
    "eltsEndpoint": {
      "enum": [
        "mock://elts",
        "null://elts"
      ]
    }
  }
}
