{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "blockDurationSeconds",
    "practiceDurationSeconds",
    "breakDurationSeconds",
    "conditionOrder",
    "blockRepeats",
    "syntheticOnly"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "blockDurationSeconds": {
      "const": 300
    },
    "practiceDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "breakDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "conditionOrder": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "WE_MT",
          "NE_MT",
          "WE_FT",
          "NE_FT"
        ]
      }
    },
    "blockRepeats": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "syntheticOnly": {
      "const": true
    }
  }
}
