{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELTS developer diagnostic report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "recordedAtUtc",
    "result",
    "sourceRevision",
    "environment",
    "checks",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "action": {
      "type": "string"
    },
    "recordedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "sourceRevision": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "message",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "deferred"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
