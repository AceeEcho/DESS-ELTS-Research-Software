{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elts.samples.v1.schema.json",
  "title": "ELTS v1 tracking sample line",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "monotonicTicks", "head", "weapon"],
  "properties": {
    "schemaVersion": {"const": "elts.samples.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "monotonicTicks": {"type": "integer", "minimum": 0},
    "head": {"$ref": "#/$defs/tracker"},
    "weapon": {"$ref": "#/$defs/tracker"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 256},
    "tracker": {"type": "object", "additionalProperties": false, "required": ["trackerId", "connection", "validity", "pose"], "properties": {"trackerId": {"$ref": "#/$defs/id"}, "connection": {"enum": ["Disconnected", "Connected", "Reconnecting"]}, "validity": {"enum": ["Unavailable", "Valid", "OutOfRange", "DriverFault", "RejectedNativePose"]}, "pose": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/pose"}]}}, "allOf": [{"if": {"properties": {"validity": {"const": "Valid"}}}, "then": {"properties": {"connection": {"const": "Connected"}, "pose": {"$ref": "#/$defs/pose"}}}, "else": {"properties": {"pose": {"type": "null"}}}}]},
    "pose": {"type": "object", "additionalProperties": false, "required": ["positionMeters", "orientation"], "properties": {"positionMeters": {"$ref": "#/$defs/vector"}, "orientation": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z", "w"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}, "w": {"type": "number"}}}}},
    "vector": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}}
  }
}