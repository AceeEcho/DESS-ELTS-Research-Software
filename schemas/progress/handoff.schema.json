{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELTS handoff v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id",
        "tool"
      ],
      "additionalProperties": false
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "completedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:P\\d+\\.\\d+(?:\\.[SV]\\d{3})?|BOOT\\.S\\d{3}|DEV-\\d{2}(?:\\.[SV]\\d{3})?|G\\d(?:\\.\\d{2})?|D-\\d{2}|PC-\\d{3})$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "changedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "requiredAction": {
            "type": "string",
            "minLength": 1
          },
          "responsibleRole": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason",
          "requiredAction",
          "responsibleRole"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "currentGate": {
      "type": "string",
      "minLength": 1
    },
    "nextStepId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:P\\d+\\.\\d+(?:\\.[SV]\\d{3})?|BOOT\\.S\\d{3}|DEV-\\d{2}(?:\\.[SV]\\d{3})?|G\\d(?:\\.\\d{2})?|D-\\d{2}|PC-\\d{3})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextAction": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "recordedAtUtc",
    "actor",
    "branch",
    "sourceRevision",
    "completedIds",
    "changedPaths",
    "checks",
    "evidence",
    "blockers",
    "currentGate",
    "nextStepId",
    "nextAction"
  ],
  "additionalProperties": false
}
