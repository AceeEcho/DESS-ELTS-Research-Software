<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ConfigChecks.cs" />
    <Compile Include="../../unity/Assets/ELTS/Geometry/*.cs" Link="Geometry/%(Filename)%(Extension)" />
    <Compile Include="../../unity/Assets/ELTS/Config/*.cs" Link="Config/%(Filename)%(Extension)" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(NewtonsoftPath)</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireNewtonsoft" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NewtonsoftPath)')" Text="Supply -p:NewtonsoftPath with the verified Unity Newtonsoft.Json.dll path." />
  </Target>
</Project>
