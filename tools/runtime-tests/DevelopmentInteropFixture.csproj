<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DevelopmentInteropFixture.cs" />
    <Compile Include="../../unity/Assets/ELTS/Clock/SharedMonotonicClock.cs" Link="SharedMonotonicClock.cs" />
    <Compile Include="../../unity/Assets/ELTS/Elts/EltsLinkContracts.cs" Link="EltsLinkContracts.cs" />
    <Compile Include="../../unity/Assets/ELTS/Elts/SimulatedEltsLink.cs" Link="SimulatedEltsLink.cs" />
    <Compile Include="../../unity/Assets/ELTS/Session/SessionRuntime.cs" Link="SessionRuntime.cs" />
    <Compile Include="../../unity/Assets/ELTS/Session/SessionRecordingAdapter.cs" Link="SessionRecordingAdapter.cs" />
    <Compile Include="../../unity/Assets/ELTS/Session/SessionEltsLinkAdapter.cs" Link="SessionEltsLinkAdapter.cs" />
    <Compile Include="../../unity/Assets/ELTS/Scenario/ScenarioRuntime.cs" Link="ScenarioRuntime.cs" />
    <Compile Include="../../unity/Assets/ELTS/Geometry/Geometry.cs" Link="Geometry.cs" />
    <Compile Include="../../unity/Assets/ELTS/Tracking/TrackingContracts.cs" Link="TrackingContracts.cs" />
    <Compile Include="../../unity/Assets/ELTS/Logging/*.cs" Link="Logging/%(Filename)%(Extension)" />
    <Compile Include="../../unity/Assets/ELTS/Rendering/RecordedReplay.cs" Link="RecordedReplay.cs" />
    <Compile Include="../../unity/Assets/ELTS/Rendering/ProjectionModel.cs" Link="ProjectionModel.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NewtonsoftPath)' != ''">
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
  </ItemGroup>
</Project>
