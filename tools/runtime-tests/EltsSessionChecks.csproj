<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings><LangVersion>9.0</LangVersion><Nullable>enable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup>
    <Compile Include="EltsSessionChecks.cs" />
    <Compile Include="../../unity/Assets/ELTS/Clock/SharedMonotonicClock.cs" Link="Clock.cs" />
    <Compile Include="../../unity/Assets/ELTS/Geometry/Geometry.cs" Link="Geometry.cs" />
    <Compile Include="../../unity/Assets/ELTS/Logging/LoggingContracts.cs" Link="Logging.cs" />
    <Compile Include="../../unity/Assets/ELTS/Scenario/ScenarioRuntime.cs" Link="Scenario.cs" />
    <Compile Include="../../unity/Assets/ELTS/Tracking/TrackingContracts.cs" Link="Tracking.cs" />
    <Compile Include="../../unity/Assets/ELTS/Session/SessionRuntime.cs" Link="SessionRuntime.cs" />
    <Compile Include="../../unity/Assets/ELTS/Session/SessionEltsLinkAdapter.cs" Link="SessionEltsLinkAdapter.cs" />
    <Compile Include="../../unity/Assets/ELTS/Elts/EltsLinkContracts.cs" Link="EltsLinkContracts.cs" />
    <Compile Include="../../unity/Assets/ELTS/Elts/SimulatedEltsLink.cs" Link="SimulatedEltsLink.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireNewtonsoft" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(NewtonsoftPath)')" Text="Supply -p:NewtonsoftPath with the verified Unity Newtonsoft.Json.dll path." /></Target>
</Project>
