.tutorial-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #191e24; overflow: hidden; }
.tutorial-layer.tutorial-live { background-color: rgba(0, 0, 0, 0); }
.tutorial-canvas { position: absolute; width: 1920px; height: 1080px; color: #f5f3ee; }
.tutorial-eyebrow { position: absolute; top: 108px; left: 192px; right: 192px; font-size: 27px; color: #96b3c9; letter-spacing: 5px; -unity-text-align: middle-center; }
.tutorial-heading { position: absolute; top: 165px; left: 192px; right: 192px; font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.tutorial-content { position: absolute; left: 192px; right: 192px; top: 380px; height: 340px; flex-direction: row; justify-content: center; align-items: center; }
.tutorial-card { width: 420px; height: 310px; margin-left: 20px; margin-right: 20px; align-items: center; justify-content: center; border-width: 2px; border-color: #3b4752; border-radius: 18px; background-color: #1e252d; }
.tutorial-card-emphasis { border-color: #96b3c9; background-color: #222e39; }
.tutorial-card-icon { width: 140px; height: 140px; margin-bottom: 24px; }
.tutorial-card-label { font-size: 40px; -unity-text-align: middle-center; white-space: normal; }
.tutorial-card-note { font-size: 25px; color: #a8b3bf; margin-top: 12px; -unity-text-align: middle-center; }
.tutorial-instruction { position: absolute; top: 782px; left: 192px; right: 192px; font-size: 38px; -unity-text-align: middle-center; white-space: normal; }
.tutorial-detail { position: absolute; top: 880px; left: 192px; right: 192px; font-size: 30px; color: #a8b3bf; -unity-text-align: middle-center; white-space: normal; }
.tutorial-footer { position: absolute; left: 192px; right: 192px; bottom: 66px; font-size: 22px; color: #8894a0; -unity-text-align: middle-center; }
.tutorial-illustration { position: absolute; left: 300px; right: 300px; top: 345px; height: 375px; }
.tutorial-dot { position: absolute; background-color: #f5f3ee; border-radius: 50%; }
.tutorial-arrow { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; }
.tutorial-arrow-label { position: absolute; left: 1040px; top: 700px; width: 500px; color: #b4cddd; font-size: 34px; white-space: normal; }
.tutorial-arrow-mode .tutorial-instruction { top: 330px; font-size: 36px; }
.tutorial-arrow-mode .tutorial-detail { top: 430px; font-size: 30px; }
.tutorial-arrow-mode .tutorial-footer { -unity-text-align: middle-left; }
.tutorial-live .tutorial-eyebrow { top: 44px; left: 64px; right: auto; font-size: 24px; background-color: #191e24; padding: 12px 20px; border-left-width: 4px; border-left-color: #96b3c9; }
.tutorial-live .tutorial-heading { top: 110px; font-size: 48px; background-color: rgba(25,30,36,0.92); padding: 12px; border-radius: 12px; }
.tutorial-live .tutorial-instruction { top: auto; bottom: 130px; font-size: 32px; background-color: rgba(25,30,36,0.92); padding: 14px; border-radius: 12px; }
.tutorial-live .tutorial-detail { top: auto; bottom: 68px; left: 384px; right: 384px; font-size: 26px; color: #d5e2ec; background-color: rgba(25,30,36,0.92); padding: 8px 14px; border-radius: 8px; }
.tutorial-live .tutorial-footer { display: none; }
.tutorial-timer { position: absolute; left: 300px; right: 300px; top: 395px; font-size: 150px; -unity-text-align: middle-center; }
.tutorial-live .tutorial-timer { top: 48px; left: auto; right: 64px; font-size: 32px; background-color: #191e24; padding: 12px 20px; }
.tutorial-target-label { position: absolute; font-size: 28px; background-color: #222e39; color: #e0ebf3; padding: 10px 18px; border-radius: 8px; }
.tutorial-target-outline { position: absolute; border-width: 3px; border-color: #96b3c9; border-radius: 8px; }
.tutorial-small-card { width: 265px; height: 280px; margin-left: 8px; margin-right: 8px; }
.tutorial-small-card .tutorial-card-label { font-size: 32px; }
.tutorial-small-card .tutorial-card-icon { width: 80px; height: 80px; }
.tutorial-break-marker { width: 100px; font-size: 24px; color: #b0c6d7; white-space: normal; -unity-text-align: middle-center; }
.tutorial-paused { position: absolute; top: 34px; right: 64px; padding: 10px 20px; font-size: 24px; background-color: #303c48; color: #e0e8ed; border-radius: 8px; }
.tutorial-hidden { display: none; }
