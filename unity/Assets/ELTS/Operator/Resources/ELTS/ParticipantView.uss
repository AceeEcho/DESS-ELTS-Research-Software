.participant-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.participant-prompt { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(17, 17, 17, 0.82); }
.participant-title { font-size: 44px; color: rgb(244, 244, 244); -unity-font-style: bold; margin-bottom: 16px; -unity-text-align: middle-center; }
.participant-subtitle { font-size: 20px; color: rgb(192, 189, 188); -unity-text-align: middle-center; }
.participant-reticle { position: absolute; width: 18px; height: 18px; color: white; font-size: 23px; -unity-text-align: middle-center; }
.participant-ammo { position: absolute; right: 20px; bottom: 18px; padding: 8px 12px; background-color: rgba(17, 17, 17, 0.72); color: white; font-size: 18px; -unity-font-style: bold; }
.participant-hidden { display: none; }

/* Brand the prompt and ammo surface while keeping the aiming reticle white. */
.participant-ammo { border-left-width:3px; border-left-color:#e90802; }

.participant-prompt { border-top-width:3px; border-top-color:#e90802; }
